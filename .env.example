# Copy this file to `.env` and fill in ONE of the keys below. Never commit `.env`.
#
# Both providers below have a free tier, so the project still runs at $0.
# If you set both, LLM_PROVIDER=auto prefers Gemini (the team's default).

# --- Option A: Groq (free tier) -------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# --- Option B: Google AI Studio (free tier) --------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional: force a backend instead of auto-detecting.  auto | gemini | groq
# LLM_PROVIDER=auto

# Optional: use a hosted Qdrant instead of the local on-disk index.
# Leave empty to use ./data/qdrant_index (recommended, $0, fully local).
QDRANT_URL=
QDRANT_API_KEY=

# Optional overrides (defaults live in src/settings.py)
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=qwen/qwen3.8-27b
# RETRIEVAL_TOP_K=5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
