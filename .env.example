# Copy this file to `.env` and fill in your key. Never commit `.env`.
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Optional: use a hosted Qdrant instead of the local on-disk index.
# Leave empty to use ./data/qdrant_index (recommended, $0, fully local).
QDRANT_URL=
QDRANT_API_KEY=

# Optional overrides (defaults live in src/settings.py)
# GEMINI_MODEL=gemini-2.0-flash
# RETRIEVAL_TOP_K=5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
